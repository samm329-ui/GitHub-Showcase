{
  "name": "github-showcase",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "showcase": "tsx src/index.ts",
    "start:longform": "tsx src/longform/index.ts",
    "benchmark:longform": "tsx tools/longform-benchmark.ts",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "preview": "tsx tools/preview/github/preview.ts",
    "preview:live": "tsx tools/preview/shared/preview-server.ts",
    "preview:launch": "tsx tools/preview/shared/launch-preview.ts",
    "voice:audition": "node tools/run-python.mjs tools/python/kokoro-audition.py",
    "start:news": "tsx src/channels/news/index.ts",
    "news:prepare-assets": "node tools/run-python.mjs tools/python/prep_lazy_news_assets.py",
    "news:selftest-alignment": "node tools/run-python.mjs tools/python/align_audio.py --selftest",
    "scripts:list": "tsx tools/scripts-dataset.ts list",
    "scripts:show": "tsx tools/scripts-dataset.ts show",
    "fortress:build": "cargo build --release -p reach-app --manifest-path vendor/fortress-reach/Cargo.toml",
    "fortress:check": "cargo check --workspace --manifest-path vendor/fortress-reach/Cargo.toml"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "chrome-remote-interface": "^0.33.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}


