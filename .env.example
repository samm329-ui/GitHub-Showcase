# GitHub personal access token. Copy this file to .env and fill in your token.
# .env is gitignored and never committed.
GITHUB_TOKEN=

# Groq (groq.com) API key — the narration script is written by Groq.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown):
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=60000
# GROQ_MAX_RETRIES=3
# GROQ_MAX_TOKENS=3000
# GROQ_REASONING_EFFORT=low
# GROQ_MAX_INPUT_CHARS=4500
# GROQ_MAX_PROMPT_FACTS=30
#
# Free-tier Groq limits are per model and tighten as the day goes on. If you
# keep hitting 429s, switch to a lighter model, e.g. GROQ_MODEL=openai/gpt-oss-20b
# or GROQ_MODEL=qwen/qwen3.8-27b.

# Script writer: "llm" (default, Groq) or "rule" (legacy offline composer).
# SHOWCASE_SCRIPTER=llm

# Lazy News channel (see README §13). All optional - gates cannot be bypassed.
# NEWS_VOICE=am_michael          # set after listening to samples from `npm run voice:audition`
# NEWS_VOICE_SPEED=0.98          # Kokoro speed for the lazy commentator
# NEWS_LANG=en-us
# NEWS_MAX_SECONDS=90            # technical safety guard only (NOT an editorial limit)
# NEWS_ALIGN_DEGRADED=0          # 1 = proceed if alignment coverage <99% (QA flags it red)
# NEWS_KEEP_FRAMES=0             # 1 = keep work/frames for inspection
# NEWS_EVIDENCE_PORT=9223        # headless Chromium for JS-rendered evidence body text
# NEWS_RENDER_PORT=9224          # headless Chromium for frame capture (never 9222)
# NEWS_CHROME_DEBUG_URL=         # overrides NEWS_RENDER_PORT if set (e.g. http://127.0.0.1:9224)
# LAZY_NEWS_CHROME=              # explicit browser binary for the news renderer
# GUARDIAN_API_KEY=              # free Developer key (non-commercial) — discovery only by default
# GUARDIAN_LLM_ALLOWED=0         # 1 ONLY with written permission for AI processing of Guardian content

# Legacy Fortress-Reach lane — retired 2026-11-13 (see NEWS_SOURCE below).
# Kept only so NEWS_SOURCE=fortress can be revived if explicitly asked.
# REACH_MCP_URL=http://127.0.0.1:8050/mcp


# Set to 1 to restore the old hard scriptability gate (skips weak repos).
# SHOWCASE_SCRIPTABILITY_GATE=0
#
# Theme of the captured GitHub repository page. GitHub renders light or dark
# from the OS color-scheme, so without a pin it captured WHITE on light-mode
# machines (Linux) — which does not sit on the white stage. Pinned to dark
# everywhere; set "auto" to follow the OS again (never do this), or "light"
# to force light.
# SHOWCASE_CAPTURE_COLOR_SCHEME=dark
# SHOWCASE_DATASET_DIR=dataset   # script dataset root (default ./dataset)

# Lazy News discovery lane:
#   inshorts (DEFAULT, since 2026-11-13) — Inshorts' 60-word card feed, ALL categories.
#     Evidence is the card itself (attributed, single origin); scripts must say
#     "according to Inshorts"; the registry entry is owner_sanction (ToS unreviewed).
#   fortress — the retired Fortress-Reach lane (vendored MCP + browser). DEPRECATED.
#     Requires REACH_MCP_URL + a running reach-server; kept for reference only.
# NEWS_SOURCE=inshorts
# Fortress is not needed for the default lane.
# REACH_MCP_URL=http://127.0.0.1:8050/mcp

# Lazy News automated gates (opt-in; default 0 = human gates mandatory).
# 1 = gates A/B/C decided by deterministic checks; thin or self-sourced stories are REFUSED.
# NEWS_AUTO_GATES=1

# Lazy News research agent (opt-in via `--research`, e.g.
#   npm run start:news -- --research --topic technology --dry-run )
# Groq plans its own searches; Fortress-Reach is still the ONLY research environment.
# GROQ_API_KEYS=                  # comma-separated keys; rotates the active key on 429 (extends GROQ_API_KEY)
# NEWS_RESEARCH_MAX_ITERATIONS=3  # gap-follow-up iterations after the initial read
# NEWS_RESEARCH_MAX_SEARCHES=24   # total Fortress search/browse operations per run
# NEWS_RESEARCH_MAX_ARTICLES=8    # total pages read in full per run
# NEWS_RESEARCH_MAX_LLM_CALLS=12  # total Groq completions per run (plan, claims, gaps, stance audit)
# NEWS_RESEARCH_TOKEN_BUDGET=40000
# NEWS_RESEARCH_TIMEOUT_MS=600000
